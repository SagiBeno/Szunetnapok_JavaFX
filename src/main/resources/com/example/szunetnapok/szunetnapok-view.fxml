<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" minHeight="600.0" minWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.szunetnapok.SzunetnapokController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label alignment="CENTER" contentDisplay="TOP" prefHeight="40.0" prefWidth="300.0" text="Munkaszüneti napok" textAlignment="CENTER">
      <font>
         <Font name="Gadugi Bold" size="26.0" />
      </font></Label>
   <HBox alignment="CENTER" prefHeight="45.0" prefWidth="760.0">
      <children>
         <Label contentDisplay="CENTER" text="Év:">
            <font>
               <Font name="Calibri" size="16.0" />
            </font>
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Label>
         <Spinner id="spinner_year" fx:id="spinner_year" editable="true">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Spinner>
          <Button fx:id="searchButton" onAction="#onShowButtonClick" text="Keresés" />
      </children>
   </HBox>
   <Label fx:id="information_label" alignment="CENTER" contentDisplay="CENTER" prefHeight="18.0" prefWidth="611.0" textAlignment="CENTER" textFill="RED" visible="false">
      <font>
         <Font name="Calibri" size="20.0" />
      </font>
   </Label>
   <TableView fx:id="tableview" maxWidth="650.0" prefHeight="366.0" prefWidth="650.0" visible="false" VBox.vgrow="ALWAYS">
     <columns>
       <TableColumn fx:id="date_column" prefWidth="150.0" text="Dátum" />
       <TableColumn fx:id="day_column" prefWidth="150.0" text="Nap" />
         <TableColumn fx:id="holidayType_column" prefWidth="200.0" text="Ünnep" />
         <TableColumn fx:id="type_column" prefWidth="150.0" text="Típus" />
     </columns>
   </TableView>
</VBox>
